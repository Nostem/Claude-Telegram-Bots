# Copy to /etc/telegram-bots/tarot.env (setup.sh does this) and fill in.
# The file holds the bot token, so keep it readable by root only (chmod 600).

TAROT_BOT_TOKEN=
TAROT_DB_PATH=/var/lib/telegram-bots/tarot.sqlite3

# Optional, needed for feedback and refunds. Send /myid to the bot to find them.
TAROT_ADMIN_USER_IDS=
TAROT_ADMIN_CHAT_ID=

# Prices in Stars. Leave commented out to use the defaults shown.
# TAROT_LIFETIME_STARS=1650
# TAROT_FOUNDER_STARS=990
# TAROT_FOUNDER_LIMIT=100
